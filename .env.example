# ─────────────────────────────────────────────────────────────
# Entry Pass Web — environment variables (Pocketbase backend)
# Copy this file to `.env.local` and fill in your values.
# ─────────────────────────────────────────────────────────────

# Pocketbase server URL.
# Local dev:  http://127.0.0.1:8090
# Tunnel:     your Cloudflare tunnel URL (https://...)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Pocketbase admin credentials — used by the server SDK to act as superuser
# (verify auth cookies, write logs, etc.). Create one in the PB admin UI
# (http://127.0.0.1:8090/_/) or via `./pocketbase superuser upsert <email> <pass>`.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme

# Name of the httpOnly session cookie that stores the PB auth token.
AUTH_COOKIE_NAME=pb_session

# ── Optional ──────────────────────────────────────────────────

# Google Wallet pass class ID for the "Save to Wallet" button.
# Create a class in the Google Pay & Wallet Console, then set this.
# If absent, the Wallet button shows "Coming Soon".
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_PASS_CLASS_ID=

# Telegram bot for error notifications (optional).
TELEGRAM_BOT_TOKEN=
CHAT_ID=
