# ─────────────────────────────────────────────────────────────
# Entry Pass Web — environment variables (Pocketbase backend)
# Copy this file to `.env.local` and fill in your values.
# ─────────────────────────────────────────────────────────────

# Pocketbase server URL.
# Local dev:  http://127.0.0.1:8090
# Tunnel:     your Cloudflare tunnel URL (https://...)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Pocketbase DASHBOARD login (superuser) — only for opening the PB admin UI
# at http://127.0.0.1:8090/_/. The website does NOT use this account, so you
# can safely enable OTP+MFA on it (SETUP.md Part 7) — that only guards the
# dashboard. Create via `./pocketbase superuser upsert <email> <pass>`.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme

# Service account — the WEBSITE's server login (a users record with role=admin).
# Created automatically by 2-SETUP, or for existing installs run:
#   node scripts/create-service-account.mjs
# If left unset, the app falls back to the dashboard creds above (legacy).
POCKETBASE_SERVICE_EMAIL=service@entrypass.local
POCKETBASE_SERVICE_PASSWORD=changeme

# Name of the httpOnly session cookie that stores the PB auth token.
AUTH_COOKIE_NAME=pb_session

# Emails that get ADMIN access to the app (comma-separated). Everyone else
# must be added to a role in Settings → Roles before they can sign in.
ADMIN_EMAILS=you@example.com

# ── Optional ──────────────────────────────────────────────────

# Google Wallet pass class ID for the "Save to Wallet" button.
# Create a class in the Google Pay & Wallet Console, then set this.
# If absent, the Wallet button shows "Coming Soon".
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_PASS_CLASS_ID=

# Telegram bot for error notifications (optional).
TELEGRAM_BOT_TOKEN=
CHAT_ID=
