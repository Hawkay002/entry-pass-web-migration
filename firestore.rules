rules_version = '2';

// ============================================================
// Firestore Security Rules — Entry-pass Next.js rewrite.
//
// Deploy with: firebase deploy --only firestore:rules
//   (requires the Firebase CLI + a valid service account)
//
// IMPORTANT: Deploying these rules to the existing project
// (ticket-backend-5ee83) ALSO affects the still-live vanilla app.
// Coordinate timing with the cutover (Phase 4).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isSelf(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // ---- Tickets + settings + gates --------------------------------------
    // ticket_events_data/shared_event_db/tickets/{ticketId}
    // ticket_events_data/shared_event_db/settings/config
    // ticket_events_data/shared_event_db/gates/{gateId}
    // (gates live under ticket_events_data, covered by the wildcard)
    match /ticket_events_data/{docId=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ---- Activity logs ----------------------------------------------------
    // activity_logs/{logId}
    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ---- Remote locks -----------------------------------------------------
    // global_locks/{userEmail} — a user may read their own lock doc;
    // only admins write lock state.
    match /global_locks/{userEmail} {
      allow read: if isSignedIn() && isSelf(userEmail);
      allow write: if isAdmin();
    }

    // ---- Admin security settings -----------------------------------------
    // admin_settings/security (kiosk PIN + admin-only config).
    match /admin_settings/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- Dynamic roles ----------------------------------------------------
    // roles/{roleName} — authed read, admin write
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Chat + typing (legacy, kept for backwards compat) ----------------
    match /communications/{msgId} {
      allow read, write: if isSignedIn();
    }
    match /typing_status/{channelId} {
      allow read, write: if isSignedIn();
    }

    // ---- Help contacts (admin-managed) -----------------------------------
    match /help_contacts/{contactId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Audit trail (factory reset records) -----------------------------
    match /audit_trail/{doc} {
      allow write: if isAdmin();
      allow read: if isAdmin();
    }

    // ---- OG snapshots (server-only, never client-accessible) -------------
    // og_snapshots/{ticketId} — written/read by Admin SDK only
    match /og_snapshots/{doc} {
      allow read, write: if false;
    }

    // ---- Public kiosk status (existence-only, no PIN) --------------------
    // kiosk_status/{kioskId} — only { updatedAt: number }. Lets the
    // unauthenticated /kiosk page detect deletion/config-change instantly
    // via onSnapshot. No PIN or PII is stored here.
    match /kiosk_status/{kioskId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Default deny -----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
